<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="Organized C++ Ordered Set" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Release">
                <Option output="build/Example" prefix_auto="1" extension_auto="1" />
