                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-std=c++17" />
                    <Add option="-O2" />
                    <Add option="-Wall" />
                    <Add option="-Wextra" />
                </Compiler>
            </Target>
        </Build>
        <Unit filename="Example.cpp" />
        <Unit filename="OrderedSet.hpp" />
    </Project>
</CodeBlocks_project_file>
